# Copy this file to .env and fill in real values. .env is gitignored - never commit real credentials.
# Read by both docker-compose (for the pgvector/minio containers) and the Spring Boot app
# (injected into `./gradlew bootRun` by build.gradle).

POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
GEMINI_API_KEY=your-gemini-api-key
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=change-me
